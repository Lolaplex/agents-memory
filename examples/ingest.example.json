{
  "version": 1,
  "sources": [
    {
      "id": "openai-export",
      "kind": "openai-export",
      "label": "ChatGPT export",
      "paths": [],
      "globs": ["~/Downloads/*chatgpt*", "~/Downloads/*openai*export*"],
      "catalog": true,
      "extract": true
    },
    {
      "id": "agent-transcripts",
      "label": "your Agent transcripts",
      "paths": ["~/.cursor/projects/*/agent-transcripts"],
      "kind": "agent-jsonl",
      "catalog": true,
      "extract": true
    },
    {
      "id": "vscode-copilot",
      "label": "VS Code Copilot",
      "paths": [
        "~/.config/Code/User/workspaceStorage/*/chatSessions",
        "%APPDATA%/Code/User/workspaceStorage/*/chatSessions"
      ],
      "kind": "copilot-jsonl",
      "catalog": true,
      "extract": true
    },
    {
      "id": "claude-code",
      "label": "Claude Code",
      "paths": ["~/.claude/projects"],
      "kind": "claude-jsonl",
      "catalog": true,
      "extract": true
    },
    {
      "id": "antigravity",
      "label": "Antigravity",
      "paths": ["~/.gemini/antigravity/brain", "~/.gemini/antigravity-ide/brain"],
      "kind": "antigravity-brain",
      "catalog": true,
      "extract": true
    },
    {
      "id": "pi",
      "label": "Pi",
      "paths": ["~/.pi/agent/sessions"],
      "kind": "pi-jsonl",
      "catalog": true,
      "extract": true
    }
  ]
}
